<?xml version="1.0"?>
<robot name="flipper_car">

  <!-- Base Link / Chassis -->
  <link name="base_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.16 0.10 0.03"/>
      </geometry>
      <material name="chassis_mat"><color rgba="0.2 0.2 0.8 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <box size="0.16 0.10 0.03"/>
      </geometry>
    </collision>
  </link>

  <!-- Macro for 4 Wheels -->
  <!-- Left Front -->
  <link name="front_left_wheel">
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><cylinder radius="0.035" length="0.02"/></geometry><material name="wheel_mat"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><geometry><cylinder radius="0.035" length="0.02"/></geometry></collision>
  </link>
  <joint name="front_left_joint" type="continuous">
    <parent link="base_link"/><child link="front_left_wheel"/>
    <origin xyz="0.06 0.065 0" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <!-- Left Rear -->
  <link name="rear_left_wheel">
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><cylinder radius="0.035" length="0.02"/></geometry><material name="wheel_mat"/></visual>
    <collision><geometry><cylinder radius="0.035" length="0.02"/></geometry></collision>
  </link>
  <joint name="rear_left_joint" type="continuous">
    <parent link="base_link"/><child link="rear_left_wheel"/>
    <origin xyz="-0.06 0.065 0" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <!-- Right Front -->
  <link name="front_right_wheel">
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><cylinder radius="0.035" length="0.02"/></geometry><material name="wheel_mat"/></visual>
    <collision><geometry><cylinder radius="0.035" length="0.02"/></geometry></collision>
  </link>
  <joint name="front_right_joint" type="continuous">
    <parent link="base_link"/><child link="front_right_wheel"/>
    <origin xyz="0.06 -0.065 0" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <!-- Right Rear -->
  <link name="rear_right_wheel">
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><cylinder radius="0.035" length="0.02"/></geometry><material name="wheel_mat"/></visual>
    <collision><geometry><cylinder radius="0.035" length="0.02"/></geometry></collision>
  </link>
  <joint name="rear_right_joint" type="continuous">
    <parent link="base_link"/><child link="rear_right_wheel"/>
    <origin xyz="-0.06 -0.065 0" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <!-- Gazebo Skid Steer / Diff Drive Plugin -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_joint</left_joint>
      <left_joint>rear_left_joint</left_joint>
      <right_joint>front_right_joint</right_joint>
      <right_joint>rear_right_joint</right_joint>
      <wheel_separation>0.13</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- IMU Sensor to simulate the SW-520D Tilt Ball Switch -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <topic>/imu</topic>
    </sensor>
  </gazebo>

</robot>
